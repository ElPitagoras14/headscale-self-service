# Despliegue en contenedor (Dokploy): el contenedor NO lee este archivo (.dockerignore
# excluye .env). Configura estas mismas variables en el panel de Dokploy:
#   obligatorias: SHARED_INVITE_TOKEN, RESEND_API_KEY, RESEND_FROM,
#                 HEADSCALE_API_KEY, HEADSCALE_FIXED_USER
#   opcionales:   PORT (por defecto 3000), TRUST_PROXY (usar 2 detras de Cloudflare + Traefik)
# Ejecutar una sola replica (limites de tasa y cache en memoria).
#
# Token compartido que se entrega a los miembros de ESPOL
SHARED_INVITE_TOKEN=
# API key de Resend (dominio verificado mail.elpitagoras14.qzz.io)
RESEND_API_KEY=
RESEND_FROM=Kokoanet VPN <vpn@mail.elpitagoras14.qzz.io>
# API key de Headscale (headscale apikeys create)
HEADSCALE_API_KEY=
# Usuario de Headscale bajo el que se registran los dispositivos
HEADSCALE_FIXED_USER=kokoanet
PORT=3000
# Numero de proxies de confianza delante de la app (entero >= 0):
#   0 = local, sin proxy (se ignora X-Forwarded-For)
#   2 = Cloudflare + Traefik de Dokploy
# Un valor menor agrupa a los usuarios en la IP del proxy; uno mayor permite falsificar la IP.
TRUST_PROXY=0
